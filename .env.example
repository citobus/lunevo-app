# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full connection string from MongoDB Atlas (or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lunevo

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Your Firebase project ID (e.g. lunevo-abc12)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Paste the ENTIRE contents of your Firebase service account JSON as one line.
# Download it from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# On Railway set this as an environment variable (no quotes needed in the Railway UI).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default models used by the AI routes
DEFAULT_CLAUDE_MODEL=claude-haiku-4-5-20251001
INSIGHT_CLAUDE_MODEL=claude-sonnet-4-5-20250514

# ── Admin Portal ───────────────────────────────────────────────────────────────
# Comma-separated list of Google account emails that have admin access.
# Example: ADMIN_EMAILS=you@gmail.com,partner@gmail.com
ADMIN_EMAILS=you@gmail.com

# ── AI Rate Limits ───────────────────────────────────────────────────────────
# Per-user, per-hour limits for AI endpoints (defaults shown)
AI_GUIDANCE_RATE_LIMIT=30
AI_INSIGHTS_RATE_LIMIT=10

# ── Push Notifications (FCM) ─────────────────────────────────────────────────
# FCM uses the same Firebase service account above — no extra config needed.
# Ensure the Firebase project has Cloud Messaging API (V1) enabled in
# Google Cloud Console, and an APNs key is uploaded in Firebase Console.
